

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Blog</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <%- include("partials/header.ejs") %>
    <header>
        <h1>My Blog</h1>
        <p>Stories, ideas, and thoughts.</p>
    </header>

<main>
    <a href="/create">Write a new post</a>

    <h2>My Posts</h2>

    <% if (posts.length===0) { %>
        <p class="empty-state">
            No posts yet. <a href="/create">Write the first one</a>.
        </p>
        <% } else { %>

            <% posts.forEach(function(post) { %>
                <article class="post">
                    <h3>
                        <%= post.title %>
                        
                    </h3>
                    <small>Published on <%= post.date %></small>
                    <p>
                        <%= post.content %>
                    </p>

                    <a class="button button-edit" href="/edit/<%= post.id %>">
                        Edit
                    </a>

                    <form class="delete-form" action="/delete/<%= post.id %>" method="POST" 
                    
                        onsubmit="return confirm('Are you sure you want to delete this post?');"
>
                        <button class="button button-delete" type="submit">
                            Delete
                        </button>
                    </form>
                </article>
                <% }); %>

                    <% } %>
</main>
<%- include("partials/footer.ejs") %>
</body>

</html>

